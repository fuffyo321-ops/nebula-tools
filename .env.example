# ====================================
# NebulaTools — Environment Variables
# ====================================
# Copy this file to .env.local and fill in all values

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-here-min-32-chars

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/nebula_tools?schema=public"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_YEARLY_PRICE_ID=price_...

# --- Email (Nodemailer / SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=NebulaTools <noreply@nebula-tools.com>

# --- App URL (for production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Solana / Phantom (Crypto payments — USDC on Solana) ---
# Your treasury Phantom wallet address (receives USDC payments)
SOLANA_TREASURY_ADDRESS=your-phantom-wallet-address
NEXT_PUBLIC_SOLANA_TREASURY_ADDRESS=your-phantom-wallet-address
# Optional: custom RPC (default is public mainnet-beta)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Admin ---
ADMIN_EMAIL=admin@nebula-tools.com
